<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background_app">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="@dimen/_8sdp">
        <TextView android:id="@+id/skin_back" android:layout_width="@dimen/_40sdp" android:layout_height="@dimen/_40sdp"
            android:text="‹" android:textSize="28sp" android:gravity="center"
            android:textColor="@color/black_or_white" android:contentDescription="返回" />
        <TextView android:id="@+id/skin_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="角色皮肤预览" android:textSize="18sp"
            android:textColor="@color/black_or_white" android:paddingStart="@dimen/_8sdp" />
    </LinearLayout>

    <WebView android:id="@+id/skin_webview" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="@dimen/_8sdp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/action_idle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="站立" />
            <Button android:id="@+id/action_walk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="行走" />
            <Button android:id="@+id/action_run" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="奔跑" />
            <Button android:id="@+id/action_wave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="挥手" />
            <Button android:id="@+id/action_dance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="跳舞" />
            <Button android:id="@+id/action_rotate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="旋转" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
